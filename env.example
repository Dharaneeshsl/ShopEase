# Server Configuration
PORT=5000
NODE_ENV=development

# Database
# Copy this file to .env and set strong values. docker-compose.yml loads these
# from .env via env_file, so the compose file itself contains no credentials.
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=change-me
MONGO_INITDB_DATABASE=ecommerce
# For local (non-Docker) development, MongoDB runs on localhost:
MONGODB_URI=mongodb://localhost:27017/ecommerce
# Inside Docker Compose the backend reaches MongoDB via the "mongodb" service
# name, e.g.:
# MONGODB_URI=mongodb://admin:change-me@mongodb:27017/ecommerce?authSource=admin

# JWT Secret
JWT_SECRET=change-me-to-a-long-random-string

# Payment Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret

# Client URL
CLIENT_URL=http://localhost:3000

# Email Configuration (for password reset, etc.)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-email-password

# Cloud Storage (for product images)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Optional extras
JWT_EXPIRE=30d
CORS_ORIGIN=http://localhost:3000
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
EMAIL_FROM="ShopEase <noreply@example.com>"
BCRYPT_ROUNDS=10
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300 